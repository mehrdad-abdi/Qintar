<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup and device-to-device transfer, Android 12 and later (fullBackupContent below
  is the same for older versions). Only the files included here go (lint forbids excluding what is not included): the reading log, khatms and
  bookmarks (qintar.db with its write-ahead log) and the settings (the preferences DataStore).
  The Quran text (quran-text.db) is copied from the APK again, and recitation is streamed and cached
  in no_backup/, which is never backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="qintar.db" />
        <include domain="database" path="qintar.db-wal" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="qintar.db" />
        <include domain="database" path="qintar.db-wal" />
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
