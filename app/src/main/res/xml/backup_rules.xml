<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup up to Android 11; the same as data_extraction_rules.xml. Only what is included goes:
     quran-text.db, the audio cache (no_backup/) and the media index are left out. -->
<full-backup-content>
    <include domain="database" path="qintar.db" />
    <include domain="database" path="qintar.db-wal" />
    <include domain="file" path="datastore/user_prefs.preferences_pb" />
</full-backup-content>
